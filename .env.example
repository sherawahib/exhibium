# Google reCAPTCHA v2 ("I'm not a robot")
# Create keys at https://www.google.com/recaptcha/admin
# Add domains: localhost, exhibium.vercel.app (and custom domain if any)

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend (form emails → fwilliams@exhibium.com)
# https://resend.com/api-keys
# To show fwilliams@exhibium.com as the sender, verify exhibium.com in Resend Domains.
RESEND_API_KEY=
EMAIL_FROM="Exhibium <fwilliams@exhibium.com>"
EMAIL_TO=fwilliams@exhibium.com
