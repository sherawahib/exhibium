# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Gmail SMTP (login only — never shown as public From)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public addresses (shown to recipients)
EMAIL_FROM_ADDRESS=fwilliams@exhibium.com
EMAIL_TO=fwilliams@exhibium.com

# Admin dashboard (/admin/login)
ADMIN_PASSWORD=change-me
ADMIN_SECRET=long-random-string-at-least-32-chars

# Optional durable DB for Vercel (Turso). Without this, uses /tmp sqlite (ephemeral).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Google Identity (One Tap / Sign in) — used by live chat to fetch visitor email
# Create OAuth Web Client ID: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 , https://exhibium.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
